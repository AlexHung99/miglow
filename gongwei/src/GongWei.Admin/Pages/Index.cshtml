@page
@model GongWei.Admin.Pages.IndexModel
@{
    ViewData["Title"] = "內務府";
}

<h1>內務府</h1>

<p>
    @Model.DisplayName
    @if (Model.Roles.Count > 0)
    {
        <span class="roles">@string.Join("、", Model.Roles)</span>
    }
</p>

<section>
    <h2>目前狀態</h2>
    <table class="stats">
        <tbody>
            <tr><th>使用者</th><td>@Model.UserCount</td></tr>
            <tr><th>角色</th><td>@Model.CharacterCount</td></tr>
            <tr><th>待審建角申請</th><td><a asp-page="/Applications/Index">@Model.OpenApplicationCount 筆</a></td></tr>
            <tr><th>位階</th><td>@Model.RankCount</td></tr>
            <tr><th>已發布 NPC</th><td>@Model.PublishedNpcCount</td></tr>
        </tbody>
    </table>
</section>

@if (!Model.RulesSeeded)
{
    <section class="notice">
        <h2>尚未灌入規則資料</h2>
        <p>
            位階、能力標籤、地點與 NPC 都還沒有資料，因此建角審核無法進行。
            請依 <code>implementation_bootstrap_v1.1</code> §7 的順序執行
            <code>seed_rules_v1.1.sql</code> 與 <code>seed_npcs_v1.1.sql</code>，
            再以 <code>GongWei.AdminCli verify-database</code> 驗收。
        </p>
    </section>
}

<section class="notice">
    <h2>尚未掛載的模組</h2>
    <p>
        立繪審核與核可佇列等頁面仍是 v1.0 時期的版本，尚未依 v1.1 重寫，
        因此暫時排除在編譯之外（任務 #15）。原始碼保留在
        <code>src/GongWei.Admin/PendingV11/</code>。
    </p>
</section>
