@page
@model GongWei.Admin.Pages.Account.SignInModel
@{
    ViewData["Title"] = "登入";
    Layout = "_Layout";
}

<div class="signin">
    <h1>宮闈浮生 內務府</h1>
    <p class="signin__subtitle">控制後台</p>

    @if (Model.ErrorMessage is not null)
    {
        <p class="signin__error" role="alert">@Model.ErrorMessage</p>
    }

    @* asp-antiforgery is on by default for forms; the token is validated globally. *@
    <form method="post">
        <label for="username">帳號</label>
        <input id="username" asp-for="Username" autocomplete="username" autofocus />
        <span asp-validation-for="Username" class="signin__field-error"></span>

        <label for="password">密碼</label>
        <input id="password" asp-for="Password" type="password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="signin__field-error"></span>

        <button type="submit">登入</button>
    </form>

    <p class="signin__note">
        本後台使用獨立帳號，與玩家的 LINE 登入無關。連續五次失敗將鎖定十五分鐘。
    </p>
</div>
