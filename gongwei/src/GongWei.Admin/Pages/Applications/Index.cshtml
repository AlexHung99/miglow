@page
@model GongWei.Admin.Pages.Applications.IndexModel
@{
    ViewData["Title"] = "建角審核";
}

<div class="page-heading">
    <div>
        <span>CHARACTER APPLICATIONS</span>
        <h1>建角審核佇列</h1>
        <p>檢視玩家送出的完整人物設定、立繪與申請狀態。</p>
    </div>
    <strong>@Model.Items.Count 筆待審</strong>
</div>

@if (Model.Items.Count == 0)
{
    <div class="empty card">目前沒有等待審核的建角申請。</div>
}
else
{
    <div class="table-wrap application-queue">
        <table>
            <thead>
                <tr>
                    <th>玩家</th>
                    <th>角色</th>
                    <th>身份</th>
                    <th>立繪</th>
                    <th>送審時間</th>
                    <th>版本</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><strong>@item.PlayerName</strong></td>
                    <td>@item.FullName</td>
                    <td><span class="badge">@item.RoleLabel</span></td>
                    <td>@item.PortraitLabel</td>
                    <td>@item.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>v@item.Version</td>
                    <td><a class="button" asp-page="/Applications/Review" asp-route-id="@item.Id">檢視與審核</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
