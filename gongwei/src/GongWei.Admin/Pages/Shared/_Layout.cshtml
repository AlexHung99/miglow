@using GongWei.Admin.Security
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="same-origin" />
    <title>@ViewData["Title"] — 宮闈浮生 管理後台</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Index">宮闈浮生 · 管理後台</a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            @* Only pages that exist. asp-page pointing at a quarantined page throws while
               rendering the layout, which would take down every screen including this one.
               The unbuilt modules are shown as disabled so the nav still describes the
               finished shape of the back office. *@
            <nav class="nav">
                <a asp-page="/Index">總覽</a>
                <a asp-page="/Audit/Index">稽核紀錄</a>
                <span class="nav__pending" title="尚未依 v1.1 重寫（任務 #15）">建角審核</span>
                <span class="nav__pending" title="尚未依 v1.1 重寫（任務 #15）">圖片審核</span>
                <span class="nav__pending" title="尚未依 v1.1 重寫（任務 #15）">雙人覆核</span>
            </nav>

            <form method="post" asp-page="/Account/SignOut" class="signout">
                <span class="who">@User.Identity!.Name</span>
                <button type="submit">登出</button>
            </form>
        }
    </header>

    <main class="content">
        @if (TempData["Success"] is string success)
        {
            <div class="flash flash-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="flash flash-error">@error</div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        後端規格書 v1.1 · 所有管理操作皆留存稽核紀錄
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
