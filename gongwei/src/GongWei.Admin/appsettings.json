{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\GongWeiData\\logs\\admin-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "AllowedHosts": "gongwei-admin.miglow.vip",

  "DataProtection": {
    "//": "Outside the deployment directory so a redeploy does not invalidate cookies (spec 2.3).",
    "KeyRingPath": "C:\\GongWeiData\\keyring\\admin"
  },

  "MediaStorage": {
    "RootPath": "C:\\GongWeiData\\media"
  },

  "LineLogin": {
    "//": "Provider Max / Channel 宮闈浮生, Channel ID 2011123657. ChannelSecret comes from IIS/Windows configuration, never from this file.",
    "ChannelId": "2011123657",
    "ChannelSecret": "",
    "RedirectUri": "https://gongwei-admin.miglow.vip/Account/SignIn?handler=Callback"
  }
}
