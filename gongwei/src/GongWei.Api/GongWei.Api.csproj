<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>gongwei-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GongWei.Infrastructure\GongWei.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- v1.0-era controllers, kept out of the build until task #14 rewrites them against
         api_v1_v1.1.md. They are retained rather than deleted because they are the only
         record of which endpoints already had an implementation. Do not re-include a file
         here without porting it to the v1.1 paths, DTOs and error codes first. -->
    <Compile Remove="PendingV11\**\*.cs" />
    <None Include="PendingV11\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
